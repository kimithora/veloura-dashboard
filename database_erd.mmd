%%{init: {"theme": "forest", "themeVariables": {"fontSize": "16px", "fontFamily": "Arial"}}}%%
erDiagram

    %% =====================================================
    %% VELOURA — ERD aktual (sinkron dengan db.sqlite3)
    %% =====================================================

    ROLE ||--o{ USER : "memiliki (role)"
    USER ||--o{ CUSTOMER : "profil pelanggan (opsional)"
    USER ||--o{ ORDER : "kasir pembuat / desainer ditunjuk"
    USER ||--o{ ORDER_STATUS_HISTORY : "mengubah status"
    USER ||--o{ PAYMENT : "mengonfirmasi pembayaran"
    USER ||--o{ PRODUCTION : "desainer produksi"
    USER ||--o{ MATERIAL_REQUEST : "pengaju / penyetujui bahan"
    USER ||--o{ MATERIAL_USAGE : "mencatat pemakaian bahan"
    USER ||--o{ QUALITY_CONTROL : "melakukan pemeriksaan QC"
    USER ||--o{ DESIGN : "membuat desain"
    USER ||--o{ DESIGN_VERSION : "membuat revisi desain"
    USER ||--o{ STOCK_MOVEMENT : "mencatat gerakan stok"
    USER ||--o{ TRANSACTION : "melayani transaksi (kasir)"
    USER ||--o{ DJANGO_ADMIN_LOG : "log admin"
    USER ||--o{ DJANGO_SESSION : "sesi login"

    ROLE {
        integer id PK
        varchar code UK
        varchar name
        text description
    }

    USER {
        integer id PK
        varchar username UK
        varchar email
        varchar first_name
        varchar last_name
        varchar phone
        text address
        boolean is_active
        boolean is_staff
        boolean is_superuser
        datetime last_login
        datetime date_joined
        bigint role_id FK
    }

    CUSTOMER ||--o{ ORDER : "memesan"
    CUSTOMER ||--o{ MEASUREMENT : "data ukuran badan"
    CUSTOMER ||--o{ FITTING : "sesi fitting"
    CUSTOMER ||--o{ TRANSACTION : "bertransaksi"

    CUSTOMER {
        integer id PK
        varchar customer_id UK
        varchar full_name
        varchar phone
        varchar email
        text address
        text notes
        varchar source
        decimal total_spending
        datetime created_at
        datetime updated_at
        bigint user_id FK
        bigint created_by_id FK
        bigint updated_by_id FK
    }

    MEASUREMENT {
        integer id PK
        varchar measurement_id UK
        date measurement_date
        decimal chest_circumference
        decimal waist_circumference
        decimal hip_circumference
        decimal shoulder_width
        decimal sleeve_length
        decimal arm_circumference
        decimal neck_circumference
        decimal garment_length
        decimal skirt_trouser_length
        text notes
        datetime created_at
        datetime updated_at
        bigint customer_id FK
        bigint order_id FK
        bigint created_by_id FK
        bigint updated_by_id FK
    }

    ORDER ||--o{ ORDER_STATUS_HISTORY : "riwayat status"
    ORDER ||--o{ PRODUCTION : "rekam produksi"
    ORDER ||--o{ DESIGN : "desain"
    ORDER ||--o{ FITTING : "fitting"
    ORDER ||--o{ QUALITY_CONTROL : "QC"
    ORDER ||--o{ MEASUREMENT : "terkait ukuran (opsional)"

    ORDER {
        integer id PK
        varchar order_number UK
        datetime order_date
        date required_date
        varchar status
        text description
        decimal total_amount
        decimal dp_amount
        text notes
        datetime created_at
        datetime updated_at
        bigint customer_id FK
        bigint cashier_id FK
        bigint designer_id FK
        bigint created_by_id FK
        bigint updated_by_id FK
    }

    ORDER_STATUS_HISTORY {
        integer id PK
        varchar status
        datetime changed_at
        text notes
        datetime created_at
        datetime updated_at
        bigint order_id FK
        bigint changed_by_id FK
    }

    CATEGORY ||--o{ PRODUCT : "mengelompokkan"
    BRAND ||--o{ PRODUCT : "merek (opsional)"
    SUPPLIER ||--o{ PRODUCT : "mengasokkan produk (opsional)"
    PRODUCT ||--o{ PRODUCT_VARIANT : "varian ukuran/warna"
    PRODUCT_VARIANT ||--o{ BARCODE : "kode batang"
    PRODUCT_VARIANT ||--o{ TRANSACTION_ITEM : "terjual dalam transaksi"
    BARCODE }o--|| BARCODE : "diregenerate dari (self-ref)"

    CATEGORY {
        integer id PK
        varchar name UK
        varchar slug UK
        text description
        datetime created_at
        datetime updated_at
    }

    BRAND {
        integer id PK
        varchar name UK
        varchar slug UK
        text description
        datetime created_at
        datetime updated_at
    }

    PRODUCT {
        integer id PK
        varchar sku UK
        varchar name
        text description
        varchar source
        varchar status
        decimal purchase_price
        decimal selling_price
        integer min_stock
        varchar image
        datetime created_at
        datetime updated_at
        bigint category_id FK
        bigint brand_id FK
        bigint supplier_id FK
    }

    PRODUCT_VARIANT {
        integer id PK
        varchar sku UK
        varchar barcode UK
        varchar size
        varchar color
        integer stock_quantity
        decimal selling_price
        decimal purchase_price
        boolean is_active
        datetime created_at
        datetime updated_at
        bigint product_id FK
    }

    BARCODE {
        integer id PK
        varchar barcode_value UK
        varchar format
        boolean is_active
        datetime created_at
        datetime updated_at
        bigint product_variant_id FK
        bigint regenerated_from_id FK
    }

    SUPPLIER ||--o{ MATERIAL : "mengasokkan bahan (opsional)"
    SUPPLIER ||--o{ PRODUCT : "mengasokkan produk (opsional)"

    SUPPLIER {
        integer id PK
        varchar supplier_id UK
        varchar name
        varchar contact_person
        varchar phone
        varchar email
        text address
        varchar supplier_type
        text notes
        datetime created_at
        datetime updated_at
        bigint created_by_id FK
        bigint updated_by_id FK
    }

    TRANSACTION ||--o{ PAYMENT : "pembayaran"
    TRANSACTION ||--o{ TRANSACTION_ITEM : "item transaksi"

    TRANSACTION {
        integer id PK
        varchar transaction_number UK
        datetime transaction_date
        varchar status
        varchar payment_status
        boolean stock_deducted
        decimal subtotal
        decimal discount_amount
        decimal grand_total
        text notes
        datetime created_at
        datetime updated_at
        bigint customer_id FK
        bigint cashier_id FK
        bigint created_by_id FK
        bigint updated_by_id FK
    }

    TRANSACTION_ITEM {
        integer id PK
        integer quantity
        decimal unit_price
        decimal discount
        decimal total
        datetime created_at
        datetime updated_at
        bigint transaction_id FK
        bigint product_variant_id FK
    }

    PAYMENT {
        integer id PK
        varchar payment_type
        varchar method
        varchar status
        decimal amount
        date due_date
        datetime confirmed_at
        varchar payment_proof
        text notes
        datetime created_at
        datetime updated_at
        bigint transaction_id FK
        bigint confirmed_by_id FK
        bigint created_by_id FK
        bigint updated_by_id FK
    }

    MATERIAL ||--o{ MATERIAL_REQUEST : "permintaan bahan"
    MATERIAL ||--o{ MATERIAL_USAGE : "pemakaian bahan"
    DJANGO_CONTENT_TYPE ||--o{ STOCK_MOVEMENT : "jenis objek (polimorfik)"
    PRODUCT_VARIANT }o--o{ STOCK_MOVEMENT : "stok barang jadi (via ContentType)"
    MATERIAL }o--o{ STOCK_MOVEMENT : "stok bahan baku (via ContentType)"

    MATERIAL {
        integer id PK
        varchar material_id UK
        varchar name
        varchar category
        varchar unit
        decimal stock_quantity
        decimal min_stock
        decimal purchase_price
        text notes
        datetime created_at
        datetime updated_at
        bigint supplier_id FK
        bigint created_by_id FK
        bigint updated_by_id FK
    }

    STOCK_MOVEMENT {
        integer id PK
        varchar movement_type
        decimal quantity
        decimal previous_stock
        decimal new_stock
        varchar reference
        text notes
        datetime created_at
        datetime updated_at
        bigint content_type_id FK
        integer object_id
        bigint user_id FK
    }

    PRODUCTION ||--o{ MATERIAL_REQUEST : "permintaan bahan"
    PRODUCTION ||--o{ MATERIAL_USAGE : "pemakaian bahan"
    MATERIAL_REQUEST ||--o{ MATERIAL_USAGE : "realisasi pemakaian"

    PRODUCTION {
        integer id PK
        varchar production_id UK
        date start_date
        date estimated_completion
        date actual_completion
        integer progress
        varchar status
        text notes
        datetime created_at
        datetime updated_at
        bigint order_id FK
        bigint designer_id FK
        bigint created_by_id FK
        bigint updated_by_id FK
    }

    MATERIAL_REQUEST {
        integer id PK
        varchar request_id UK
        varchar status
        decimal quantity
        text notes
        datetime created_at
        datetime updated_at
        bigint production_id FK
        bigint material_id FK
        bigint requested_by_id FK
        bigint approved_by_id FK
        bigint created_by_id FK
        bigint updated_by_id FK
    }

    MATERIAL_USAGE {
        integer id PK
        varchar usage_id UK
        decimal quantity_used
        datetime used_at
        text notes
        datetime created_at
        datetime updated_at
        bigint production_id FK
        bigint material_request_id FK
        bigint material_id FK
        bigint used_by_id FK
        bigint created_by_id FK
        bigint updated_by_id FK
    }

    FITTING {
        integer id PK
        varchar fitting_id UK
        datetime scheduled_date
        datetime fitting_date
        text results
        text alterations_required
        varchar documentation
        varchar status
        datetime created_at
        datetime updated_at
        bigint order_id FK
        bigint customer_id FK
        bigint created_by_id FK
        bigint updated_by_id FK
    }

    QUALITY_CONTROL {
        integer id PK
        varchar qc_id UK
        boolean stitching_quality
        boolean size_accuracy
        boolean fabric_quality
        boolean color_consistency
        boolean design_conformity
        boolean cleanliness
        boolean final_appearance
        varchar status
        datetime qc_date
        text notes
        datetime created_at
        datetime updated_at
        bigint order_id FK
        bigint qc_by_id FK
        bigint created_by_id FK
        bigint updated_by_id FK
    }

    DESIGN {
        integer id PK
        varchar design_id UK
        varchar name
        varchar category
        varchar sketch
        varchar customer_reference
        varchar fabric
        varchar color
        text style_description
        integer version
        varchar status
        decimal estimated_cost
        integer estimated_duration_days
        text notes
        datetime created_at
        datetime updated_at
        bigint order_id FK
        bigint designer_id FK
        bigint created_by_id FK
        bigint updated_by_id FK
    }

    DESIGN_VERSION {
        integer id PK
        integer version_number
        varchar sketch
        text notes
        datetime created_at
        datetime updated_at
        bigint design_id FK
        bigint created_by_id FK
    }

    DJANGO_CONTENT_TYPE {
        integer id PK
        varchar app_label
        varchar model
    }

    DJANGO_ADMIN_LOG {
        integer id PK
        text object_id
        varchar object_repr
        smallint action_flag
        text change_message
        datetime action_time
        bigint content_type_id FK
        bigint user_id FK
    }

    DJANGO_SESSION {
        varchar session_key PK
        text session_data
        datetime expire_date
    }
